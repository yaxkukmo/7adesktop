# Przykladowy config dla 7acenter (utils/7acenter.c).
#
# Docelowa sciezka: ~/.7a/center.conf (katalog ~/.7a jest wspoldzielony
# z 7acal/7atodo, ale ten plik jest wlasnoscia wylacznie 7acenter).
# Plik tworzy/przepisuje konfigurator 7acenter (przycisk "Edit"), mozna
# tez zaczac od tego przykladu:
#
#   mkdir -p ~/.7a && cp center.conf.sample ~/.7a/center.conf
#
# UWAGA: kazdy zapis z konfiguratora przepisuje caly plik - komentarze
# (takie jak ten) NIE przetrwaja.
#
# Format:
#  - linia "[Nazwa]" zaczyna zakladke-kategorie (max 10); pozycje przed
#    pierwsza sekcja (stary format bez sekcji) trafiaja do zakladki "Main";
#  - jedna pozycja na linie, "Nazwa|komenda argumenty" albo
#    "Nazwa|komenda argumenty|ikona" (trzecie pole opcjonalne);
#  - puste linie i linie zaczynajace sie od "#" sa ignorowane;
#  - komenda jest dzielona spacjami; "..." grupuje argument ze spacjami
#    (cudzyslowy sa usuwane, bez escapowania), uruchamiana przez execvp, wiec musi byc w $PATH
#    albo podana pelna sciezka;
#  - reczna zmiana pliku wymaga ponownego uruchomienia 7acenter.
#
# Ikony: bez trzeciego pola 7acenter probuje sam znalezc "<basename
# pierwszego slowa z komendy>.xpm" (potem .xbm) (np. dla "xterm -e vi" szuka
# "xterm.xpm") w typowych katalogach ikon (/usr/share/pixmaps,
# /usr/local/share/pixmaps, /usr/X11R6/include/X11/pixmaps - OpenBSD,
# /usr/share/icons/hicolor/{32x32,48x48}/apps + wlasne katalogi z zasobu
# X "7aCenter.iconPath", patrz Xresources.sample). To CZESTO nie
# wystarcza - wspolczesne apki GTK/Qt czesto NIE instaluja juz .xpm
# (tylko PNG/SVG w motywie), a apki z TEGO projektu w ogole nie maja
# zadnej ikony na dysku - stad trzecie pole pozwala nadpisac automatyczne
# zgadywanie:
#  - zaczyna sie od "/" -> bezwzgledna sciezka do KONKRETNEGO pliku .xpm albo .xbm
#    (.xbm rysowane w kolorze iconForeground, np. utils/icons/*_48.xbm),
#    bez przeszukiwania katalogow (np. wlasna ikona narysowana recznie);
#  - inaczej -> wlasna nazwa bazowa do przeszukania tych samych katalogow
#    (np. "Nazwa|./7atimer|clock", jesli w ktoryms katalogu jest clock.xpm).
# Gdy nic nie pasuje (ani zgadywanie, ani trzecie pole), pokazuje kolorowy
# kwadrat z inicjalem nazwy.

[System]
Terminal|xterm
Calculator|xcalc
Text Editor|xterm -e vi

[Internet]
Browser|firefox
